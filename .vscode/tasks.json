{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc build multi-arquivo",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.c",
                "prologo.c",
                "lovelace.c",
                "joan_clarke.c",
                "grace_hopper.c",
                "hamilton.c",
                "carol_shaw.c",
                "-o",
                "jogo_temporal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}
